
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWave IPTV Channel Database",
  "type": "object",
  "required": ["schema_version", "channels"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channel"
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": [
        "id",
        "name",
        "country",
        "language",
        "categories",
        "streams"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "news",
              "sports",
              "entertainment",
              "movies",
              "series",
              "documentary",
              "kids",
              "music",
              "regional",
              "general",
              "religious",
              "shopping"
            ]
          }
        },
        "logo_url": {
          "type": "string",
          "format": "uri"
        },
        "epg_id": {
          "type": "string"
        },
        "streams": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stream"
          }
        }
      }
    },
    "stream": {
      "type": "object",
      "required": [
        "url",
        "status",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "unavailable",
            "restricted"
          ]
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "last_checked": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
